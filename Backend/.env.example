# Email configuration
EMAIL_USER=your-email@example.com
EMAIL_PASS=replace-with-your-email-app-password
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587

# Database configuration
DB_HOST=127.0.0.1
DB_PORT=3307
DB_USER=app_user
DB_PASSWORD=replace-with-the-database-password
DB_NAME=billetera
MYSQL_ROOT_PASSWORD=replace-with-a-root-password
MYSQL_APP_USER=app_user
MYSQL_APP_PASSWORD=replace-with-the-database-password

# LLM configuration
# Obtener una clave en https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
LLM_MODEL=openai/gpt-oss-120b
LLM_FALLBACK_BASE_URL=https://api.cerebras.ai/v1
LLM_FALLBACK_API_KEY=
LLM_FALLBACK_MODEL=
LLM_TIMEOUT_SECONDS=30
