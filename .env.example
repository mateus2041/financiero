# Copy to .env for local development and replace each placeholder.
# Never use these values as production credentials.
MYSQL_ROOT_PASSWORD=replace-with-a-long-random-root-password
DB_USER=app_user
DB_PASSWORD=replace-with-a-long-random-app-password
DB_NAME=billetera
MYSQL_PORT=3307
JWT_SECRET_KEY=replace-with-at-least-32-random-characters
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Public URL used by the browser. The /api suffix matches the existing Axios client.
REACT_APP_API_URL=http://127.0.0.1:8000/api

# Optional integrations
ASESOR_REGISTRATION_CODE=
EMAIL_USER=
EMAIL_PASS=
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
GROQ_API_KEY=
LLM_API_KEY=
LLM_FALLBACK_API_KEY=
