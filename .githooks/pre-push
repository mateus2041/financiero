#!/bin/sh
set -eu

while read -r local_ref local_sha remote_ref remote_sha; do
    [ -n "$local_sha" ] || continue
    case "$local_sha" in
        0000000000000000000000000000000000000000) continue ;;
    esac

    if [ -z "$remote_sha" ] || [ "$remote_sha" = "0000000000000000000000000000000000000000" ]; then
        commits=$(git rev-list "$local_sha" --not --remotes=origin 2>/dev/null || git rev-list "$local_sha")
    else
        commits=$(git rev-list "$local_sha" "^$remote_sha")
    fi

    for commit in $commits; do
        env_files=$(git diff-tree --root --no-commit-id --name-only -r "$commit" |
            grep -E '(^|/)\.env([./]|$)' |
            grep -Ev '(^|/)\.env\.example$' || true)
        if [ -n "$env_files" ]; then
            printf '%s\n' "ERROR: El historial que intentas subir contiene archivos .env:" "$env_files" \
                "Eliminalos del historial antes de volver a hacer push."
            exit 1
        fi

        if git show --format= --no-ext-diff --unified=0 "$commit" |
            grep -Eq '^\+[^+].*gsk_[A-Za-z0-9_-]{20,}'; then
            printf '%s\n' "ERROR: El historial que intentas subir parece contener una clave de Groq."
            exit 1
        fi
    done
done

exit 0
