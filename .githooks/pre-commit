#!/bin/sh
set -eu

env_files=$(git diff --cached --name-only --diff-filter=ACMR |
    grep -E '(^|/)\.env([./]|$)' |
    grep -Ev '(^|/)\.env\.example$' || true)

if [ -n "$env_files" ]; then
    printf '%s\n' "ERROR: No incluyas archivos .env en un commit:" "$env_files" \
        "Guarda las credenciales localmente y usa .env.example con valores vacios."
    exit 1
fi

if git diff --cached --no-ext-diff --unified=0 -- . |
    grep -Eq '^\+[^+].*gsk_[A-Za-z0-9_-]{20,}'; then
    printf '%s\n' "ERROR: El cambio parece contener una clave de Groq. Retirala antes de hacer commit."
    exit 1
fi
